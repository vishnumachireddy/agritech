# AgroSmart AI Backend Configuration Template
# Copy this file to .env and configure with your actual production/staging secrets.

# MongoDB Connection URI (Atlas or Local)
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=agri&compressors=zlib

# JWT Secret for Signing Authentication Tokens (Must be a 64+ char random hex string in production)
JWT_SECRET=generate_a_secure_random_jwt_secret_key_minimum_32_characters

# Groq AI Cloud API Key for LLM & Vision Pathology
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenWeatherMap API Key
WEATHER_API_KEY=your_openweathermap_api_key_here

# Redis URL for Caching and Distributed Rate Limiting (Optional - falls back to direct DB if empty/offline)
REDIS_URL=redis://localhost:6379/0

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,https://smart-farming-rgm.onrender.com

# Brevo / SMTP Real-Time Email Dispatch Configuration (OTP, Deliveries, Drone, Weather)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=c28aa6001@smtp-brevo.com
SMTP_PASSWORD=xsmtpsib-your_brevo_smtp_key_here
SMTP_FROM="AgriSmart <your_verified_sender_email@example.com>"
DEFAULT_ALERT_EMAIL=alerts@agritech.com
